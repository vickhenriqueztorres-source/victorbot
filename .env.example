# ============================================================
# CONFIGURAÇÃO DO BOT TELEGRAM - INFILTRUS SIGNALS
# ============================================================

# 1. Cole aqui o Token gerado no @BotFather do Telegram
TELEGRAM_BOT_TOKEN=COLE_SEU_TOKEN_AQUI

# 2. Link oficial de afiliado da B2 Trading para novos cadastros
BROKER_AFFILIATE_URL=https://b2trading.com/register?ref=infiltrus

# 3. Nome e papel da pessoa que conversa com o cliente
PERSONA_NAME=Brenda
PERSONA_ROLE=Mentora Infiltrus

# 4. Dias de validade da licença gerada automaticamente (padrão: 30)
LICENSE_DAYS=30

# 5. ID do canal de notificações (Opcional - deixe vazio para escutar qualquer canal onde o bot for admin)
NOTIFICATION_CHANNEL_ID=

# 6. Seu ID do Telegram para ter acesso aos comandos /admin e /liberar (opcional)
ADMIN_IDS=
